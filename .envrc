# Create venv and install deps if needed
if [ ! -d .venv ]; then
  echo "Creating virtual environment..."
  uv venv
fi

# Install/sync project dependencies
uv pip install -e "." --quiet

# Install requirements.txt if it exists
if [ -f "$PWD/../requirements.txt" ]; then
  uv pip install -r "$PWD/../requirements.txt" --quiet
fi

# Activate the venv
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Load variables from .env if it exists
if [ -f "$PWD/.env" ]; then
  dotenv "$PWD/.env"
fi

# Ensure spaCy model is available
if ! python -c "import en_core_web_trf" 2>/dev/null; then
  echo "Downloading spaCy model en_core_web_trf..."
  python -m spacy download en_core_web_trf
fi

# ── MLX-VLM server (Apple Silicon GPU for PaddleOCR-VL) ──
# Auto-started in the background when entering the project directory.
# Idempotent: a running server is reused; a stale PID is replaced.
# Stop manually with: `mlx-stop`  (function defined below)
MLX_PID_FILE="$PWD/.mlx_server.pid"
MLX_LOG_FILE="$PWD/logs/mlx_server.log"
MLX_PORT="${MLX_VLM_PORT:-8111}"

# HTTP probe — the accurate "is the server actually serving requests?" check.
# The PID alone is misleading: uvicorn binds the port a few seconds after
# launch, and the model takes ~2 min to load on first start; during that
# window the process is alive but the API isn't ready. A crashed child
# under a still-alive wrapper would also fool a PID-only check.
mlx_server_running() {
  if curl -fs -o /dev/null --connect-timeout 1 --max-time 2 \
       "http://localhost:$MLX_PORT/health"; then
    echo "running (port $MLX_PORT)"
    return 0
  else
    echo "not running"
    return 1
  fi
}

# Internal: did we already spawn a wrapper? Used for auto-start dedup and
# by `mlx-stop`, which needs the PID to send SIGTERM regardless of whether
# the HTTP layer is responding.
mlx_server_pid_alive() {
  [ -f "$MLX_PID_FILE" ] && kill -0 "$(cat "$MLX_PID_FILE")" 2>/dev/null
}

if [[ "$OSTYPE" == "darwin"* ]] && [[ "$(uname -m)" == "arm64" ]]; then
  if mlx_server_running >/dev/null; then
    echo "MLX-VLM server already running (pid $(cat "$MLX_PID_FILE" 2>/dev/null), port $MLX_PORT)"
  elif command -v mlx_vlm.server >/dev/null 2>&1; then
    # HTTP probe failed — any existing PID file is stale (process died but
    # cleanup didn't run, e.g. SIGKILL). Drop it before spawning a fresh one.
    if [ -f "$MLX_PID_FILE" ]; then
      if mlx_server_pid_alive; then
        # PID file points at *something* that's alive but not serving — likely
        # a recycled PID belonging to an unrelated process. Don't kill it.
        echo "Stale PID file $MLX_PID_FILE points to a non-MLX process — removing."
      fi
      rm -f "$MLX_PID_FILE"
    fi
    mkdir -p "$(dirname "$MLX_LOG_FILE")"
    echo "Starting MLX-VLM server on port $MLX_PORT (logs → $MLX_LOG_FILE)"
    nohup ./scripts/start_mlx_server.sh "$MLX_PORT" \
      >"$MLX_LOG_FILE" 2>&1 &
    echo $! >"$MLX_PID_FILE"
    disown
  else
    echo "mlx_vlm.server not found — skipping auto-start. Run 'uv pip install -e \".\"' to install."
  fi

  # Helper: stop the auto-started MLX server.
  # Defined here so it's available in any shell with this .envrc loaded.
  mlx-stop() {
    if mlx_server_pid_alive; then
      kill "$(cat "$MLX_PID_FILE")" && rm -f "$MLX_PID_FILE"
      echo "MLX-VLM server stopped."
    else
      echo "MLX-VLM server is not running."
      rm -f "$MLX_PID_FILE"
    fi
  }
  export -f mlx_server_running mlx_server_pid_alive mlx-stop 2>/dev/null || true
fi
