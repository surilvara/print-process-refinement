# Create venv and install deps if needed
if [ ! -d .venv ]; then
  echo "Creating virtual environment..."
  uv venv
fi

# Install/sync project dependencies
uv pip install -e "." --quiet

# Install requirements.txt if it exists
if [ -f "$PWD/../requirements.txt" ]; then
  uv pip install -r "$PWD/../requirements.txt" --quiet
fi

# Activate the venv
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Load variables from .env if it exists
if [ -f "$PWD/.env" ]; then
  dotenv "$PWD/.env"
fi

# Ensure spaCy model is available
if ! python -c "import en_core_web_trf" 2>/dev/null; then
  echo "Downloading spaCy model en_core_web_trf..."
  python -m spacy download en_core_web_trf
fi

# MLX-VLM servers (PaddleOCR-VL on :8111, GLM-OCR on :8112) are managed by
# `./scripts/mlx`. They are no longer auto-started here — the Gradio app
# launches them on demand, or you can run `./scripts/mlx start paddle`.
