# Create venv and install deps if needed
if [ ! -d .venv ]; then
  echo "Creating virtual environment..."
  uv venv
fi

# Install/sync project dependencies
uv pip install -e "." --quiet

# Activate the venv
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Ensure spaCy model is available
if ! python -c "import en_core_web_trf" 2>/dev/null; then
  echo "Downloading spaCy model en_core_web_trf..."
  python -m spacy download en_core_web_trf
fi

# ── MLX-VLM server (Apple Silicon GPU for PaddleOCR-VL) ──
# Auto-started in the background when entering the project directory.
# Idempotent: a running server is reused; a stale PID is replaced.
# Stop manually with: `mlx-stop`  (function defined below)
MLX_PID_FILE="$PWD/.mlx_server.pid"
MLX_LOG_FILE="$PWD/logs/mlx_server.log"
MLX_PORT="${MLX_VLM_PORT:-8111}"

mlx_server_running() {
  [ -f "$MLX_PID_FILE" ] && kill -0 "$(cat "$MLX_PID_FILE")" 2>/dev/null
}

if [[ "$OSTYPE" == "darwin"* ]] && [[ "$(uname -m)" == "arm64" ]]; then
  if mlx_server_running; then
    echo "MLX-VLM server already running (pid $(cat "$MLX_PID_FILE"), port $MLX_PORT)"
  elif command -v mlx_vlm.server >/dev/null 2>&1; then
    mkdir -p "$(dirname "$MLX_LOG_FILE")"
    echo "Starting MLX-VLM server on port $MLX_PORT (logs → $MLX_LOG_FILE)"
    nohup ./scripts/start_mlx_server.sh "$MLX_PORT" \
      >"$MLX_LOG_FILE" 2>&1 &
    echo $! >"$MLX_PID_FILE"
    disown
  else
    echo "mlx_vlm.server not found — skipping auto-start. Run 'uv pip install -e \".\"' to install."
  fi

  # Helper: stop the auto-started MLX server.
  # Defined here so it's available in any shell with this .envrc loaded.
  mlx-stop() {
    if mlx_server_running; then
      kill "$(cat "$MLX_PID_FILE")" && rm -f "$MLX_PID_FILE"
      echo "MLX-VLM server stopped."
    else
      echo "MLX-VLM server is not running."
      rm -f "$MLX_PID_FILE"
    fi
  }
  export -f mlx_server_running mlx-stop 2>/dev/null || true
fi
